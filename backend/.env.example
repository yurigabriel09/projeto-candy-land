DATABASE_URL=sqlite:///candyland.db

FRONTEND_URL=http://localhost:5173
SECRET_KEY=troque-por-uma-chave-secreta-forte
JWT_EXPIRATION_HOURS=24

# Geocodificação automática do endereço de entrega (API Geocoding habilitada no Google Cloud).
# Chave restrita à API Geocoding e mantida apenas no backend.
GOOGLE_CLIENT_ID=ID_DO_CLIENTE_GOOGLE
GOOGLE_MAPS_GEOCODING_API_KEY=IDA_DA_CHAVE_DE_API_GOOGLE
GOOGLE_CLOCK_SKEW_SECONDS=300

FACEBOOK_CLIENT_ID=ID_DO_CLIENTE_FACEBOOK
FACEBOOK_CLIENT_SECRET=ID_DO_CLIENTE_FACEBOOK
# Deve coincidir exatamente com a URL cadastrada no app Meta e usar o mesmo host de VITE_API_URL.
FACEBOOK_REDIRECT_URI=http://localhost:5000/auth/facebook/callback

BREVO_API_KEY=ID_DA_CHAVE_DE_API_BREVO
BREVO_SENDER_EMAIL=ENDEREÇO_DE_EMAIL_DO_REMETENTE
BREVO_SENDER_NAME=CandyLand

TWILIO_ACCOUNT_SID=SEU_ACCOUNT_SID
TWILIO_AUTH_TOKEN=SEU_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=SEU_CONTENT_SID

# Permite celular compartilhado apenas em desenvolvimento/testes.
# Em produção, APP_ENV=production desativa a opção mesmo se ela ficar true.
APP_ENV=development
ALLOW_DUPLICATE_PHONE=true

# Pix e cartões usam Mercado Pago; PayPal é configurado separadamente quando escolhido no checkout.
# Nunca coloque segredos no frontend nem faça commit do arquivo .env real.
PAYMENT_PROVIDER=auto
MERCADO_PAGO_ACCESS_TOKEN=COLE_AQUI_O_ACCESS_TOKEN_DE_TESTE
MERCADO_PAGO_SANDBOX=true
# URL de retorno do FRONTEND. Localmente, localhost:5173 funciona; publique HTTPS no ambiente de homologação.
MERCADO_PAGO_RETURN_URL_BASE=http://localhost:5173
# Até configurar HTTPS para o BACKEND e cadastrar o webhook, mantenha ambos vazios.
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_WEBHOOK_SECRET=

# PayPal Orders v2: use credenciais Sandbox inicialmente; nunca exponha no frontend.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=COLE_AQUI_O_CLIENT_ID_SANDBOX
PAYPAL_CLIENT_SECRET=COLE_AQUI_O_SECRET_SANDBOX
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL_BASE=http://localhost:5173
# Configure depois de cadastrar e validar o webhook no painel PayPal.
PAYPAL_WEBHOOK_ID=
